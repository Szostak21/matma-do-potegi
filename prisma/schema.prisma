generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["matma"]
}

enum LeadStatus {
  PENDING_DEPOSIT
  PAID_DEPOSIT
  ACTIVE
  CANCELLED
  RESIGNED
  REFUNDED

  @@schema("matma")
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED

  @@schema("matma")
}

enum PaymentType {
  DEPOSIT
  FIRST_MONTH_TOPUP
  SUBSCRIPTION
  INDIVIDUAL_LESSON

  @@schema("matma")
}

enum PaymentProvider {
  STRIPE
  TPAY

  @@schema("matma")
}

enum MessageChannel {
  SMS
  EMAIL

  @@schema("matma")
}

enum PackageType {
  MATURA_ROZSZERZONA
  MATURA_PODSTAWOWA
  OSMOKLASISTA
  INDYWIDUALNE

  @@schema("matma")
}

enum UserRole {
  OWNER
  TEACHER
  STUDENT

  @@schema("matma")
}

enum TuitionPeriodStatus {
  DUE
  PAID
  PARTIAL
  WAIVED

  @@schema("matma")
}

enum TuitionPaymentMethod {
  TRANSFER
  CASH
  STRIPE
  OTHER

  @@schema("matma")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]

  @@schema("matma")
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups    Group[]

  @@schema("matma")
}

model Group {
  id            String      @id @default(cuid())
  name          String
  packageType   PackageType
  scheduleSlot  String
  maxCapacity   Int         @default(8)
  currentCount  Int         @default(0)
  priceMonthly  Int
  depositAmount Int         @default(5000)
  teacherId     String?
  teacher       Teacher?    @relation(fields: [teacherId], references: [id])
  leads         Lead[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("matma")
}

model Lead {
  id                     String       @id @default(cuid())
  parentName             String
  studentName            String?
  phoneNumber            String
  email                  String
  requestedPackage       PackageType?
  schoolClass            String?      @map("currentGrade")
  notes                  String?
  placementTestNotes     String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  referredById           String?
  referredBy             Lead?        @relation("LeadReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              Lead[]       @relation("LeadReferrals")
  referralRewardApplied  Boolean      @default(false)
  firstMonthDiscountGrosze Int        @default(0)
  /// Stała zniżka stosowana w każdym miesiącu czesnego (grosze).
  standingDiscountGrosze Int          @default(0)
  isDeleted              Boolean      @default(false)
  skipDeposit            Boolean      @default(false)
  resignedAt             DateTime?
  tuitionStartMonth      DateTime?    @db.Date
  status                 LeadStatus   @default(PENDING_DEPOSIT)
  groupId                String?
  group                  Group?       @relation(fields: [groupId], references: [id])
  balanceCredit          Int          @default(0)
  firstMonthPaid         Boolean      @default(false)
  activePaymentId        String?
  userId                 String?
  user                   User?        @relation(fields: [userId], references: [id])
  payments               Payment[]
  tuitionPeriods         TuitionPeriod[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([referredById])
  @@index([status])
  @@index([requestedPackage])
  @@schema("matma")
}

model Payment {
  id                  String          @id @default(cuid())
  token               String          @unique @default(cuid())
  /// Krótki kod do linku wysyłanego SMS-em (/p/<shortCode>).
  shortCode           String?         @unique
  leadId              String
  lead                Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type                PaymentType
  status              PaymentStatus   @default(PENDING)
  provider            PaymentProvider @default(STRIPE)
  amount              Int
  billingPeriod       DateTime?       @db.Date
  expiresAt           DateTime?
  paidAt              DateTime?
  providerSessionId   String?         @unique
  providerCheckoutUrl String?
  tuitionPeriodId     String?
  tuitionPeriod       TuitionPeriod?  @relation(fields: [tuitionPeriodId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([leadId, billingPeriod, type])
  @@index([tuitionPeriodId])
  @@schema("matma")
}

model TuitionPeriod {
  id               String                @id @default(cuid())
  leadId           String
  lead             Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Pierwszy dzień miesiąca rozliczeniowego (np. 2026-10-01)
  periodMonth      DateTime              @db.Date
  /// Kwota z cennika (snapshot), edytowalna w panelu Płatności.
  baseAmountGrosze Int
  /// Wartość dodatnia = zniżka, ujemna = dopłata. amountDueGrosze = base - discount.
  discountGrosze   Int                   @default(0)
  amountDueGrosze  Int
  amountPaidGrosze Int                   @default(0)
  status           TuitionPeriodStatus   @default(DUE)
  paidAt           DateTime?
  paymentMethod    TuitionPaymentMethod?
  transferTitle    String?
  notes            String?
  /// Znacznik "Wysłane" dla trybu manualnego (przełączany z panelu).
  messageSentAt    DateTime?
  payments         Payment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([leadId, periodMonth])
  @@index([status, periodMonth])
  @@schema("matma")
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String
  channel   MessageChannel @default(SMS)
  body      String
  isDefault Boolean        @default(false)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([channel, sortOrder])
  @@schema("matma")
}
