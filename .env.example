# =====================================================================
# Matma do potęgi — szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij realnymi wartościami (.env jest gitignored)
# =====================================================================

# --- Baza danych (Supabase PostgreSQL, schemat "matma") ---
# Hasło i project-ref znajdziesz w: Supabase Dashboard -> Project Settings -> Database

# Pooled connection (runtime aplikacji, port 6543, pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=matma"

# Direct connection (migracje Prisma, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=matma"

# --- Zabezpieczenie panelu admina i cronów ---
# Dostep do /admin i /api/cron przez ?secret=... (dlugi, losowy ciag)
ADMIN_SECRET="wygeneruj_dlugi_losowy_sekret"

# --- Supabase API (kolejne etapy — storage materiałów) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# --- Resend (wysyłka maili — kolejne etapy) ---
RESEND_API_KEY="re_..."
