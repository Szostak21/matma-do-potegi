# Copy to .env and fill in real values. .env is gitignored.

# --- Database (PostgreSQL, schema "matma") ---
# Local: docker compose up -d, then the URLs below.
# Characters in the password must be URL-encoded (+ → %2B, / → %2F, @ → %40).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=matma"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=matma"

# --- Admin panel and cron ---
# Admin signs in at /admin. The value is the password; it is never put in the URL.
ADMIN_SECRET="generate_a_long_random_secret"
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/*.
CRON_SECRET="generate_a_different_long_random_secret"

# --- Supabase API (optional, later stages) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# --- App URL (required for Stripe success/cancel redirects) ---
# Production example: https://www.matmadopotegi.pl
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ---
# Test: sk_test_..., pk_test_..., whsec_...
# Live: sk_live_..., pk_live_..., whsec_...
# The API keys and STRIPE_WEBHOOK_SECRET must come from the same mode.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# PAYMENTS_SIMULATE="true"  # local only

# Webhook URL in production: https://www.matmadopotegi.pl/api/payments/webhook

# --- Resend (transactional email) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="MatmaDoPotegi <noreply@matmadopotegi.pl>"
# Comma-separated. Defaults to the studio contact address.
ADMIN_NOTIFICATION_EMAILS="you@example.com"

# --- Analytics (loaded only after cookie consent) ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID=""
# Server-side Conversions API token. Never prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=""
NEXT_PUBLIC_CLARITY_ID=""
