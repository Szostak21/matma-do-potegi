# =====================================================================
# Matma do potęgi — szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij realnymi wartościami (.env jest gitignored)
# =====================================================================

# --- Baza danych (Supabase PostgreSQL, schemat "matma") ---
# Hasło i project-ref znajdziesz w: Supabase Dashboard -> Project Settings -> Database

# Pooled connection (runtime aplikacji, port 6543, transaction mode)
# Region i prefix poolera: Supabase Dashboard -> Connect -> URI (np. aws-1-eu-west-1)
# Znaki specjalne w haśle muszą być URL-encoded (+ → %2B, / → %2F, @ → %40)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD_URL_ENCODED]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=matma"

# Direct connection (migracje Prisma, port 5432, session mode)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD_URL_ENCODED]@aws-1-[REGION].pooler.supabase.com:5432/postgres?schema=matma"

# --- Zabezpieczenie panelu admina i cronów ---
# Dostep do /admin i /api/cron przez ?secret=... (dlugi, losowy ciag)
ADMIN_SECRET="wygeneruj_dlugi_losowy_sekret"

# --- Supabase API (kolejne etapy — storage materiałów) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# --- Aplikacja (absolutny URL — wymagany dla Stripe success/cancel) ---
# Produkcja: https://www.matmadopotegi.pl
# Lokalnie:  http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (płatności zaliczki) ---
# Sandbox (test): sk_test_..., pk_test_..., whsec_... z endpointu webhook w trybie Test
# Live:         sk_live_..., pk_live_..., whsec_... z endpointu webhook w trybie Live
# Klucze API i STRIPE_WEBHOOK_SECRET muszą być z tego samego trybu (Test lub Live)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# PAYMENTS_SIMULATE="true"  # tylko lokalnie — NIE ustawiaj na Vercel Production

# --- Vercel Production (osobno w Dashboard, nie w .env lokalnym) ---
# NEXT_PUBLIC_APP_URL=https://www.matmadopotegi.pl
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — jak wyżej
# Webhook URL w Stripe: https://www.matmadopotegi.pl/api/payments/webhook
# Po zmianie env na Vercel: Redeploy

# --- Resend (wysyłka maili — ETAP 7) ---
# Wymaga zweryfikowanej domeny matmadopotegi.pl w Resend (rekordy DNS)
RESEND_API_KEY="re_..."
EMAIL_FROM="MatmaDoPotęgi <noreply@matmadopotegi.pl>"

# --- Analityka i marketing (ładowane wyłącznie po zgodzie w banerze cookies) ---
# GA4: Google Analytics -> Administracja -> Strumienie danych -> Web -> Identyfikator pomiaru
# Format: G-XXXXXXXXXX (np. G-ABC123XYZ0)
# Vercel: dodaj jako NEXT_PUBLIC_GA_ID, środowiska Production + Preview, potem Redeploy
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Meta Pixel: Meta Events Manager -> Źródła danych -> Pixel -> ID pixela (opcjonalnie)
# Vercel: dodaj jako NEXT_PUBLIC_META_PIXEL_ID, gdy uruchomisz kampanie Meta Ads
NEXT_PUBLIC_META_PIXEL_ID=""

# Meta Conversions API (CAPI) — zdarzenia serwerowe (SEKRET, bez NEXT_PUBLIC_!)
# Token: Events Manager -> Ustawienia -> Conversions API -> Wygeneruj token dostępu
# Wysyła serwerowe zdarzenie "Lead" wyłącznie gdy użytkownik wyraził zgodę marketingową
# (ta sama co Meta Pixel: cookie matma_cookie_consent=granted). Deduplikacja po event_id.
# Vercel: dodaj jako META_CAPI_ACCESS_TOKEN (Production + Preview), potem Redeploy
META_CAPI_ACCESS_TOKEN=""

# Opcjonalnie: kod testowy z Events Manager -> Test Events (tylko do debugowania).
# Ustaw lokalnie, by zdarzenia trafiały do zakładki "Testuj zdarzenia"; usuń na produkcji.
# META_CAPI_TEST_EVENT_CODE="TEST12345"

# Microsoft Clarity: clarity.microsoft.com -> Settings -> Setup -> Project ID
# Na produkcji (Vercel): NEXT_PUBLIC_CLARITY_ID jest ustawione — Clarity nagrywa sesje po zgodzie cookies
NEXT_PUBLIC_CLARITY_ID=""

# --- Powiadomienia administratora (opcjonalnie) ---
# ADMIN_NOTIFICATION_EMAILS="admin1@example.com,admin2@example.com"

# --- Vercel CLI (opcjonalnie — generowane przez `vercel env pull`) ---
# VERCEL_OIDC_TOKEN="..."
